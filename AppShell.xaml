<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="UniversalYoga.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:local="clr-namespace:UniversalYoga"
    Shell.NavBarIsVisible="False"
    Shell.FlyoutBehavior="Disabled"    
    xmlns:views="clr-namespace:UniversalYoga.Views"
       xmlns:Helper="clr-namespace:UniversalYoga.Helpers"
       FlyoutHeaderBehavior="Fixed"
       Shell.TabBarBackgroundColor="{OnPlatform UWP='#81248A',WinUI='#81248A',Android='White',iOS='White'}"
       Shell.TabBarUnselectedColor="Gray"
       Shell.BackgroundColor="Transparent">

    <TabBar Shell.TabBarTitleColor="{StaticResource SecondoryColor}" >

        <Tab Icon="home_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:HomePage}" />
        </Tab>

        <Tab  Icon="course_icon.png">
            <ShellContent ContentTemplate="{DataTemplate views:BookedPage}"/>
        </Tab>

    </TabBar>

</Shell>
