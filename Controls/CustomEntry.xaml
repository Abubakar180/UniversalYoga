<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniversalYoga.Controls.CustomEntry">
    <!--ContentView For Creating Custom Entry Control. 
        Here we can design according to our desire.-->
    <ContentView.Content>

        <Grid>
            <!--Border of the Entry.-->
            <Border BackgroundColor="White"
                    x:Name="entryFrame"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 12,12,12,12"
                    Padding="10,5">
                <Border.Stroke>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Color="{StaticResource PrimaryColor}" Offset="0.1" />
                        <GradientStop Color="{StaticResource SecondoryColor}" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Stroke>
                <!--Grid under the Border.-->
                <Grid>
                    <!--Entry Control With Focused and Unfocused Funtion.-->
                    <Entry FontSize="18"
                           FontFamily="Texta" 
                           x:Name="Entry"
                           TextColor="Black"
                           BackgroundColor="White"
                           VerticalOptions="CenterAndExpand"
                           VerticalTextAlignment="Center"
                           Focused="Entry_Focused"
                           Unfocused="Entry_Unfocused"/>
                    <!--Label Control Designed to behave like entry placeholder.-->
                    <Label x:Name="PlaceHolder"
                           VerticalTextAlignment="Center"
                           HorizontalTextAlignment="End"
                           TextColor="LightGray"
                           FontSize="18"
                           Margin="0,0,0,-5"
                           FontFamily="Texta" >
                        <!--Label Tapped function.-->
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                        </Label.GestureRecognizers>

                    </Label>

                </Grid>

            </Border>
            <!--Frame In which title of entry is appearing.
            This Frame is animates when entry is focused or unfocused.-->

            <Frame x:Name="titleFrame"
                   BackgroundColor="White"
                   BorderColor="Transparent"
                   Margin="10,0"
                   CornerRadius="0"
                   Padding="0"
                   HasShadow="False"
                   HorizontalOptions="Start"
                   VerticalOptions="CenterAndExpand">

                <Frame.GestureRecognizers>
                    <TapGestureRecognizer Tapped="TapGestureRecognizer_Tapped"/>
                </Frame.GestureRecognizers>
                <!--Label Control behaving like title of entry.-->
                <Label FontSize="16"
                       Margin="2,0,2,0"
                       x:Name="Title"
                       FontFamily="Texta"
                       TextColor="#C5C6C7"/>

            </Frame>


        </Grid>

    </ContentView.Content>
</ContentView>
