<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="UniversalYoga.Views.ForgotPasswordPage"
             NavigationPage.HasNavigationBar="False"       
             xmlns:behaviour="clr-namespace:UniversalYoga.Behaviours"
             xmlns:control="clr-namespace:UniversalYoga.Controls"
             xmlns:toolkit="http://schemas.microsoft.com/dotnet/2022/maui/toolkit"
             BackgroundColor="White">
    <Grid RowDefinitions="*">
        <ScrollView Grid.Row="0">
            <StackLayout Margin="20"
                         VerticalOptions="CenterAndExpand"
                         Spacing="20">
                <StackLayout Spacing="5"
                             Margin="0,20">

                    <Image Source="yoga_pose2.png"
                            Aspect="AspectFit"
                            HorizontalOptions="CenterAndExpand"
                            HeightRequest="60"/>

                    <Label Text="Universal Yoga"
                            FontFamily="Texta"
                            HorizontalTextAlignment="Center"
                            FontAttributes="Bold"
                            FontSize="26"
                            TextColor="{StaticResource SecondoryColor}"/>
                </StackLayout>

                <StackLayout Spacing="20">

                    <control:CustomEntry TitleText="Email"
                                         Keyboard="Email"
                                         EntryTextColor="{Binding EmailColor,Mode=TwoWay}"
                                         EntryText="{Binding Email,Mode=TwoWay}">
                        <control:CustomEntry.EntryBehavior>
                            <behaviour:EmailValidatorBehavior x:Name="emailBehaviour" />
                        </control:CustomEntry.EntryBehavior>
                    </control:CustomEntry>


                </StackLayout>

                <Button Text="Send Link"
                        FontFamily="Texta"
                        FontSize="Medium" 
                        TextColor="White"
                        Background="{StaticResource Gradient}"
                        HorizontalOptions="CenterAndExpand"
                        WidthRequest="250"
                        Margin="0,20"
                        CornerRadius="8"
                        x:Name="login"
                       Command="{Binding SendCMD, Mode=TwoWay}"/>

            </StackLayout>
        </ScrollView>
    </Grid>
</ContentPage>