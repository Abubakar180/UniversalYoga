<?xml version = "1.0" encoding = "UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:UniversalYoga"
             x:Class="UniversalYoga.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Resources/Styles/Colors.xaml" />
                <ResourceDictionary Source="Resources/Styles/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
            <Color x:Key="baseColor">#00B6B2</Color>
            <Color x:Key="PrimaryColor">#81248A</Color>
            <Color x:Key="SecondoryColor">#E70B89</Color>
            <LinearGradientBrush x:Key="Gradient"  StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="{StaticResource PrimaryColor}" Offset="0.1" />
                <GradientStop Color="{StaticResource SecondoryColor}" Offset="1.0" />
            </LinearGradientBrush>
            <LinearGradientBrush x:Key="DisGradient"  StartPoint="0,0" EndPoint="0,1">
                <GradientStop Color="#c5c6c7" Offset="0.1" />
                <GradientStop Color="#ffffff" Offset="1.0" />
            </LinearGradientBrush>
            <Style TargetType="Entry">
                <Setter Property="TextColor" Value="Black" />
            </Style>
            <Style TargetType="ScrollView">
                <Setter Property="VerticalScrollBarVisibility" Value="Never" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Never" />
            </Style>
            <Style TargetType="CollectionView">
                <Setter Property="VerticalScrollBarVisibility" Value="Never" />
                <Setter Property="HorizontalScrollBarVisibility" Value="Never" />
            </Style>
            <Style x:Key="btnStyle" TargetType="Button">
                <Setter Property="BackgroundColor" Value="{StaticResource SecondoryColor}" />
                <Setter Property="TextColor" Value="White" />
                <Setter Property="TextTransform" Value="None" />
                <Setter Property="FontFamily" Value="Texta" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="48" />
            </Style>
            <Style x:Key="EntryStyle" TargetType="Entry">
                <Setter Property="TextColor" Value="Black" />
                <Setter Property="FontSize" Value="16" />
                <Setter Property="FontFamily" Value="Texta" />
                <Setter Property="VerticalTextAlignment" Value="Center" />
            </Style>
            <Style x:Key="entryFrameStyle" TargetType="Frame">
                <Setter Property="HasShadow" Value="False" />
                <Setter Property="BackgroundColor" Value="White" />
                <Setter Property="BorderColor" Value="LightGray" />
                <Setter Property="CornerRadius" Value="12" />
                <Setter Property="HeightRequest" Value="48" />
                <Setter Property="Padding" Value="10,0" />
            </Style>
            <Style x:Key="textButton" TargetType="Button">
                <Setter Property="BackgroundColor" Value="Transparent"/>
                <Setter Property="Padding" Value="5"/>
                <Setter Property="FontFamily" Value="Texta"/>
                <Setter Property="FontSize" Value="Body"/>
                <Setter Property="TextColor" Value="{StaticResource PrimaryColor}"/>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
